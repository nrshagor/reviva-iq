<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_revivaiq_dashboard_list" model="ir.ui.view">
        <field name="name">revivaiq.dashboard.list</field>
        <field name="model">revivaiq.dashboard</field>
        <field name="arch" type="xml">
            <list string="RevivaIQ Overview">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_revivaiq_dashboard_form" model="ir.ui.view">
        <field name="name">revivaiq.dashboard.form</field>
        <field name="model">revivaiq.dashboard</field>
        <field name="arch" type="xml">
            <form string="RevivaIQ Dashboard" create="0" delete="0">

                <header>
                    <button name="action_open_dead_stock_analysis_wizard"
                            string="Run Dead Stock"
                            type="object"
                            class="btn-primary"/>

                    <button name="action_open_customer_recovery_wizard"
                            string="Run Customer Recovery"
                            type="object"
                            class="btn-primary"/>

                    <button name="action_open_snapshot_generation_wizard"
                            string="Generate Snapshot"
                            type="object"
                            class="btn-secondary"/>
                </header>

                <sheet class="o_form_sheet_full_width">

                    <field name="currency_id" invisible="1"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>

                        <p class="text-muted">
                            Operational revenue recovery dashboard for active dead stock,
                            customer recovery opportunities, and snapshot-based revenue risk.
                        </p>
                    </div>

                    <div class="row mt16">

                        <!-- DEAD STOCK -->
                        <div class="col-lg-4 col-md-12 mb-4">
                            <group string="DEAD STOCK RECOVERY">

                                <div class="alert alert-danger" role="alert"
                                     invisible="dead_stock_count == 0">
                                    <strong>
                                        <field name="dead_stock_count" readonly="1"/>
                                    </strong>
                                    active dead stock item(s) detected with estimated risk value of
                                    <strong>
                                        <field name="dead_stock_total_risk_value"
                                               widget="monetary"
                                               readonly="1"/>
                                    </strong>
                                </div>

                                <div class="alert alert-success" role="alert"
                                     invisible="dead_stock_count != 0">
                                    No active dead stock risk detected.
                                </div>

                                <field name="dead_stock_days_threshold" readonly="1"/>
                                <field name="dead_stock_count" readonly="1"/>
                                <field name="dead_stock_total_risk_value"
                                       widget="monetary"
                                       readonly="1"/>
                                <field name="last_dead_stock_run" readonly="1"/>

                                <button name="action_open_dead_stock"
                                        string="View Dead Stock Details"
                                        type="object"
                                        class="btn-secondary"/>
                            </group>
                        </div>

                        <!-- CUSTOMER RECOVERY -->
                        <div class="col-lg-4 col-md-12 mb-4">
                            <group string="CUSTOMER RECOVERY">

                                <div class="alert alert-warning" role="alert"
                                     invisible="inactive_customer_count == 0">
                                    <strong>
                                        <field name="inactive_customer_count" readonly="1"/>
                                    </strong>
                                    inactive customer opportunity record(s) detected.
                                </div>

                                <div class="alert alert-success" role="alert"
                                     invisible="inactive_customer_count != 0">
                                    No inactive customer recovery risk detected.
                                </div>

                                <field name="customer_inactivity_days_threshold"
                                       readonly="1"/>

                                <field name="inactive_customer_count"
                                       readonly="1"/>

                                <field name="high_score_customer_count"
                                       readonly="1"/>

                                <field name="customer_recovery_value"
                                       widget="monetary"
                                       readonly="1"/>

                                <field name="last_customer_recovery_run"
                                       readonly="1"/>

                                <button name="action_open_customer_insights"
                                        string="View Customer Insights"
                                        type="object"
                                        class="btn-secondary"/>
                            </group>
                        </div>

                        <!-- SNAPSHOT -->
                        <div class="col-lg-4 col-md-12 mb-4">
                            <group string="ANALYTICS SNAPSHOT">

                                <div class="alert alert-info" role="alert"
                                     invisible="latest_snapshot_count == 0">

                                    Latest revenue risk snapshot estimated at

                                    <strong>
                                        <field name="latest_total_revenue_risk"
                                               widget="monetary"
                                               readonly="1"/>
                                    </strong>
                                </div>

                                <div class="alert alert-secondary" role="alert"
                                     invisible="latest_snapshot_count != 0">
                                    No analytics snapshot generated yet.
                                </div>

                                <field name="latest_snapshot_count"
                                       readonly="1"/>

                                <field name="latest_total_revenue_risk"
                                       widget="monetary"
                                       readonly="1"/>

                                <field name="last_snapshot_run"
                                       readonly="1"/>

                                <button name="action_open_analytics_snapshots"
                                        string="View Snapshot History"
                                        type="object"
                                        class="btn-secondary"/>
                            </group>
                        </div>

                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_revivaiq_dashboard" model="ir.actions.act_window">
        <field name="name">RevivaIQ Dashboard</field>
        <field name="res_model">revivaiq.dashboard</field>
        <field name="view_mode">form,list</field>
        <field name="res_id" ref="revivaiq_dashboard_default"/>
    </record>

    <menuitem id="menu_revivaiq_root"
              name="RevivaIQ"
              sequence="10"
              web_icon="revivaiq_base,static/description/icon.png"/>

    <menuitem id="menu_revivaiq_dashboard"
              name="Dashboard"
              parent="menu_revivaiq_root"
              action="action_revivaiq_dashboard"
              sequence="10"/>

    <menuitem id="menu_revivaiq_intelligence"
              name="Intelligence"
              parent="menu_revivaiq_root"
              sequence="20"/>

    <menuitem id="menu_revivaiq_dead_stock"
              name="Dead Stock"
              parent="menu_revivaiq_intelligence"
              action="action_revivaiq_dead_stock"
              sequence="10"/>

    <menuitem id="menu_revivaiq_customer_insight"
              name="Customer Insights"
              parent="menu_revivaiq_intelligence"
              action="action_revivaiq_customer_insight"
              sequence="20"/>

    <menuitem id="menu_revivaiq_analytics_snapshot"
              name="Analytics Snapshots"
              parent="menu_revivaiq_intelligence"
              action="action_revivaiq_analytics_snapshot"
              sequence="30"/>
</odoo>