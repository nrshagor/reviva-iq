<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_revivaiq_dashboard_list" model="ir.ui.view">
        <field name="name">revivaiq.dashboard.list</field>
        <field name="model">revivaiq.dashboard</field>
        <field name="arch" type="xml">
            <list string="RevivaIQ Overview">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_revivaiq_dashboard_form" model="ir.ui.view">
        <field name="name">revivaiq.dashboard.form</field>
        <field name="model">revivaiq.dashboard</field>
        <field name="arch" type="xml">
            <form string="RevivaIQ Dashboard" create="0" delete="0" class="revivaiq-dashboard">
                <header>
                    <div class="header-buttons" style="display: flex; justify-content: center; width: 100%;">
                        <button name="action_open_dead_stock_analysis_wizard"
                                string="Run Dead Stock Analysis"
                                type="object"
                                class="btn-primary"
                                icon="fa-cubes"/>

                        <button name="action_open_customer_recovery_wizard"
                                string="Run Customer Recovery"
                                type="object"
                                class="btn-success"
                                icon="fa-users"/>

                        <button name="action_open_snapshot_generation_wizard"
                                string="Generate Snapshot"
                                type="object"
                                class="btn-info"
                                icon="fa-camera"/>
                    </div>
                </header>

                <sheet class="o_form_sheet_full_width">
                    <field name="currency_id" invisible="1"/>

                    <div class="oe_title">
                        <h1 class="text-center mb-3">
                            <i class="fa fa-dashboard me-2 text-primary" title="Dashboard Icon"/>
                            RevivaIQ Overview
                        </h1>
                        <p class="text-center text-muted mb-4">
                            <i class="fa fa-chart-line me-1" title="Chart Icon"/>
                            Operational revenue recovery dashboard for active dead stock,
                            customer recovery opportunities, and snapshot-based revenue risk.
                        </p>
                    </div>

                    <div class="dashboard-cards-row">
                        <!-- CARD 1: DEAD STOCK RECOVERY -->
                        <div class="dashboard-card">
                            <div class="card h-100 shadow-sm border-top-danger">
                                <div class="card-header bg-white border-bottom-0 pt-4">
                                    <div class="text-center">
                                        <i class="fa fa-cubes fa-3x text-danger mb-2" title="Dead Stock Icon"/>
                                        <h4 class="mb-0 text-danger">DEAD STOCK</h4>
                                        <p class="text-muted small">RECOVERY</p>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <div class="alert alert-danger mb-3" role="alert"
                                         invisible="dead_stock_count == 0">
                                        <i class="fa fa-exclamation-triangle me-2" title="Warning Icon"/>
                                        <strong>
                                            <field name="dead_stock_count" readonly="1"/>
                                        </strong>
                                        active dead stock item(s) detected.
                                    </div>

                                    <div class="alert alert-success mb-3" role="alert"
                                         invisible="dead_stock_count != 0">
                                        <i class="fa fa-check-circle me-2" title="Success Icon"/>
                                        No active dead stock risk detected.
                                    </div>

                                    <div class="stats-list">
                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-calendar me-2" title="Calendar Icon"/>
                                                Dead Stock Threshold
                                            </span>
                                            <span class="stat-value">
                                                <field name="dead_stock_days_threshold" readonly="1"/> days
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-cubes me-2" title="Stock Icon"/>
                                                Dead Stock Count
                                            </span>
                                            <span class="stat-value">
                                                <field name="dead_stock_count" readonly="1"/>
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-money-bill-wave me-2" title="Money Icon"/>
                                                Risk Value
                                            </span>
                                            <span class="stat-value">
                                                <field name="dead_stock_total_risk_value"
                                                       widget="monetary"
                                                       readonly="1"/>
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-clock me-2" title="Clock Icon"/>
                                                Last Run
                                            </span>
                                            <span class="stat-value">
                                                <field name="last_dead_stock_run" readonly="1"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer text-center">
                                    <button name="action_open_dead_stock"
                                            string="View Dead Stock Details"
                                            type="object"
                                            class="btn btn-outline-danger">
                                        <i class="fa fa-eye me-2" title="View Icon"/> View Details
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- CARD 2: CUSTOMER RECOVERY -->
                        <div class="dashboard-card">
                            <div class="card h-100 shadow-sm border-top-warning">
                                <div class="card-header bg-white border-bottom-0 pt-4">
                                    <div class="text-center">
                                        <i class="fa fa-users fa-3x text-warning mb-2" title="Users Icon"/>
                                        <h4 class="mb-0 text-warning">CUSTOMER</h4>
                                        <p class="text-muted small">RECOVERY</p>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <div class="alert alert-warning mb-3" role="alert"
                                         invisible="inactive_customer_count == 0">
                                        <i class="fa fa-user-clock me-2" title="User Clock Icon"/>
                                        <strong>
                                            <field name="inactive_customer_count" readonly="1"/>
                                        </strong>
                                        inactive customer opportunity record(s) detected.
                                    </div>

                                    <div class="alert alert-success mb-3" role="alert"
                                         invisible="inactive_customer_count != 0">
                                        <i class="fa fa-check-circle me-2" title="Success Icon"/>
                                        No inactive customer recovery risk detected.
                                    </div>

                                    <div class="stats-list">
                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-hourglass-half me-2" title="Hourglass Icon"/>
                                                Inactivity Threshold
                                            </span>
                                            <span class="stat-value">
                                                <field name="customer_inactivity_days_threshold" readonly="1"/> days
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-user-slash me-2" title="Inactive User Icon"/>
                                                Inactive Customers
                                            </span>
                                            <span class="stat-value">
                                                <field name="inactive_customer_count" readonly="1"/>
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-chart-line me-2" title="Chart Icon"/>
                                                High Score Customers
                                            </span>
                                            <span class="stat-value">
                                                <field name="high_score_customer_count" readonly="1"/>
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-dollar-sign me-2" title="Dollar Icon"/>
                                                Recovery Value
                                            </span>
                                            <span class="stat-value">
                                                <field name="customer_recovery_value"
                                                       widget="monetary"
                                                       readonly="1"/>
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-clock me-2" title="Clock Icon"/>
                                                Last Run
                                            </span>
                                            <span class="stat-value">
                                                <field name="last_customer_recovery_run" readonly="1"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer text-center">
                                    <button name="action_open_customer_insights"
                                            string="View Customer Insights"
                                            type="object"
                                            class="btn btn-outline-warning">
                                        <i class="fa fa-chart-bar me-2" title="Chart Icon"/> View Insights
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- CARD 3: ANALYTICS SNAPSHOT -->
                        <div class="dashboard-card">
                            <div class="card h-100 shadow-sm border-top-info">
                                <div class="card-header bg-white border-bottom-0 pt-4">
                                    <div class="text-center">
                                        <i class="fa fa-camera fa-3x text-info mb-2" title="Camera Icon"/>
                                        <h4 class="mb-0 text-info">ANALYTICS</h4>
                                        <p class="text-muted small">SNAPSHOT</p>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <div class="alert alert-info mb-3" role="alert"
                                         invisible="latest_snapshot_count == 0">
                                        <i class="fa fa-chart-pie me-2" title="Chart Icon"/>
                                        Latest revenue risk snapshot estimated at
                                        <strong>
                                            <field name="latest_total_revenue_risk"
                                                   widget="monetary"
                                                   readonly="1"/>
                                        </strong>
                                    </div>

                                    <div class="alert alert-secondary mb-3" role="alert"
                                         invisible="latest_snapshot_count != 0">
                                        <i class="fa fa-info-circle me-2" title="Info Icon"/>
                                        No analytics snapshot generated yet.
                                    </div>

                                    <div class="stats-list">
                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-database me-2" title="Database Icon"/>
                                                Snapshot Count
                                            </span>
                                            <span class="stat-value">
                                                <field name="latest_snapshot_count" readonly="1"/>
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-money-bill-wave me-2" title="Money Icon"/>
                                                Revenue Risk
                                            </span>
                                            <span class="stat-value">
                                                <field name="latest_total_revenue_risk"
                                                       widget="monetary"
                                                       readonly="1"/>
                                            </span>
                                        </div>

                                        <div class="stat-item">
                                            <span class="stat-label">
                                                <i class="fa fa-clock me-2" title="Clock Icon"/>
                                                Last Run
                                            </span>
                                            <span class="stat-value">
                                                <field name="last_snapshot_run" readonly="1"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer text-center">
                                    <button name="action_open_analytics_snapshots"
                                            string="View Snapshot History"
                                            type="object"
                                            class="btn btn-outline-info">
                                        <i class="fa fa-history me-2" title="History Icon"/> View History
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_revivaiq_dashboard" model="ir.actions.act_window">
        <field name="name">RevivaIQ Dashboard</field>
        <field name="res_model">revivaiq.dashboard</field>
        <field name="view_mode">form,list</field>
        <field name="res_id" ref="revivaiq_dashboard_default"/>
    </record>

    <menuitem id="menu_revivaiq_root"
              name="RevivaIQ"
              sequence="10"
              web_icon="revivaiq_base,static/description/icon.png"/>

    <menuitem id="menu_revivaiq_dashboard"
              name="Dashboard"
              parent="menu_revivaiq_root"
              action="action_revivaiq_dashboard"
              sequence="10"/>

    <menuitem id="menu_revivaiq_intelligence"
              name="Intelligence"
              parent="menu_revivaiq_root"
              sequence="20"/>

    <menuitem id="menu_revivaiq_dead_stock"
              name="Dead Stock"
              parent="menu_revivaiq_intelligence"
              action="action_revivaiq_dead_stock"
              sequence="10"/>

    <menuitem id="menu_revivaiq_customer_insight"
              name="Customer Insights"
              parent="menu_revivaiq_intelligence"
              action="action_revivaiq_customer_insight"
              sequence="20"/>

    <menuitem id="menu_revivaiq_analytics_snapshot"
              name="Analytics Snapshots"
              parent="menu_revivaiq_intelligence"
              action="action_revivaiq_analytics_snapshot"
              sequence="30"/>
</odoo>