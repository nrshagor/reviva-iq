<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_revivaiq" model="ir.module.category">
        <field name="name">RevivaIQ</field>
        <field name="description">RevivaIQ Sales Recovery and Inventory Intelligence</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_revivaiq_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_revivaiq"/>
    </record>

    <record id="group_revivaiq_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_revivaiq"/>
        <field name="implied_ids" eval="[(4, ref('group_revivaiq_user'))]"/>
    </record>
</odoo>